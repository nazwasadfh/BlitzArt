#!/usr/bin/env bash
# build-iso - Build BlitzArt Linux ISO using artools buildiso
#
# BlitzArt Linux is an Artix-based distribution with:
#   - Dinit init
#   - Btrfs root with full snapshots (snapper + grub-btrfs)
#   - Repos: artix, arch, blackarch, chaotic-aur
#   - blitz system toolbox
#   - Boot to TTY (no GUI by default)
#
# Usage: ./build-iso [-i INITSYS] [-o OUT_DIR] [-w WORKSPACE] [-k] [-v]
#
# Requirements: artools (pacman -S artools)   # provides buildiso

set -euo pipefail

readonly SCRIPT_NAME="$(basename "$0")"
readonly VERSION="1.1.0"
readonly PROFILE_NAME="blitzart"
readonly DOTS_REPO="https://github.com/nazwasadfh/dots.git"

# Defaults (match artools conventions)
INITSYS="dinit"
WORKSPACE_DIR="${HOME}/artools-workspace"
OUT_DIR="./out"
KEEP_WORK=0
VERBOSE=0

# Colors
if [[ -t 1 ]]; then
    R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; C=$'\e[36m'; B=$'\e[1m'; N=$'\e[0m'
else
    R=""; G=""; Y=""; C=""; B=""; N=""
fi

msg()  { printf '%s==>%s %s\n' "$G" "$N" "$*"; }
info() { printf '%s  ->%s %s\n' "$C" "$N" "$*"; }
warn() { printf '%s==> WARNING:%s %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%s==> ERROR:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
    cat <<EOF
$SCRIPT_NAME v$VERSION - Build BlitzArt Linux ISO with artools buildiso

Usage: $SCRIPT_NAME [options]

Options:
  -i, --init INITSYS   Init system: openrc | runit | s6 | dinit (default: dinit)
  -o, --out DIR        Output directory (default: ./out)
  -w, --work DIR       artools workspace (default: ~/artools-workspace)
  -k, --keep-work      Keep the workspace after build
  -v, --verbose        Verbose output
  -h, --help           Show this help

Requirements: artools (pacman -S artools)   # provides buildiso

The script creates the artools profile at:
  <work>/iso-profiles/${PROFILE_NAME}/
  { Packages-Root, live-overlay/, root-overlay/ }

and runs:
  buildiso -p ${PROFILE_NAME} -i <INITSYS>

The finished ISO lands in:
  <work>/iso/   and is copied to <out>/
EOF
}

# ---------- Parse args ----------
while (( $# )); do
    case $1 in
        -i|--init)       INITSYS="$2"; shift 2 ;;
        -o|--out)        OUT_DIR="$2"; shift 2 ;;
        -w|--work)       WORKSPACE_DIR="$2"; shift 2 ;;
        -k|--keep-work)  KEEP_WORK=1; shift ;;
        -v|--verbose)    VERBOSE=1; shift ;;
        -h|--help)       usage; exit 0 ;;
        *) die "Unknown option: $1 (use --help)" ;;
    esac
done

# ---------- Sanity checks ----------
msg "BlitzArt Linux ISO builder v$VERSION"

[[ $EUID -eq 0 ]] || die "Run as root (buildiso needs root)."

have buildiso || {
    die "buildiso not found. Install artools first: pacman -S artools"
}
info "Using buildiso: $(command -v buildiso)"

# Validate init system
case $INITSYS in
    openrc|runit|s6|dinit) ;;
    *) die "Unsupported init system: $INITSYS (openrc | runit | s6 | dinit)" ;;
esac

msg "Init system: $INITSYS"
msg "Workspace:   $WORKSPACE_DIR"
msg "Profile:     $PROFILE_NAME"

# Network check (required for dots clone)
msg "Checking network connectivity"
if ! ping -c1 -W3 archlinux.org >/dev/null 2>&1 && ! ping -c1 -W3 1.1.1.1 >/dev/null 2>&1; then
    die "No network. The ISO builder requires internet access."
fi
info "Network OK"

# ---------- Prepare dots repository ----------
DOTS_DIR="$(mktemp -d)"
msg "Preparing dots repository ($DOTS_REPO)"
if ! git clone --depth 1 "$DOTS_REPO" "$DOTS_DIR"; then
    warn "Could not clone dots repo; continuing without overlay configs"
fi

# ---------- Set up artools profile ----------
PROFILE_DIR="${WORKSPACE_DIR}/iso-profiles/${PROFILE_NAME}"
LIVE_OVERLAY="${PROFILE_DIR}/live-overlay"
ROOT_OVERLAY="${PROFILE_DIR}/root-overlay"

msg "Staging profile into ${PROFILE_DIR}"
rm -rf "${PROFILE_DIR}"
mkdir -p "${LIVE_OVERLAY}" "${ROOT_OVERLAY}"

# Packages-Root (rootfs packages; @initsys@ is substituted by buildiso)
PACKAGES_SRC="$(dirname "$0")/iso/${PROFILE_NAME}/packages.d/blitzart.packages"
if [[ ! -f $PACKAGES_SRC ]]; then
    die "Package list not found: $PACKAGES_SRC"
fi
cp "$PACKAGES_SRC" "${PROFILE_DIR}/Packages-Root"
info "Wrote Packages-Root ($(wc -l < "$PACKAGES_SRC") lines)"

# Overlay airootfs into live-overlay (files reach the live session verbatim)
AIROOTFS="$(dirname "$0")/iso/${PROFILE_NAME}/airootfs"
if [[ -d $AIROOTFS ]]; then
    info "Copying airoootfs into live-overlay"
    cp -a "$AIROOTFS"/. "${LIVE_OVERLAY}/"
fi

# Overlay dots configs into live session /etc/skel
if [[ -d $DOTS_DIR ]]; then
    info "Overlaying dots configs into live session /etc/skel"
    if [[ -d $DOTS_DIR/fastfetch ]]; then
        mkdir -p "${LIVE_OVERLAY}/etc/skel/.config/fastfetch"
        cp -a "$DOTS_DIR/fastfetch"/. "${LIVE_OVERLAY}/etc/skel/.config/fastfetch"/
        info "  -> /etc/skel/.config/fastfetch"
    fi
    if [[ -f $DOTS_DIR/.zshrc ]]; then
        cp -f "$DOTS_DIR/.zshrc" "${LIVE_OVERLAY}/etc/skel/.zshrc"
        info "  -> /etc/skel/.zshrc"
    fi
    if [[ -d $DOTS_DIR/kitty ]]; then
        mkdir -p "${LIVE_OVERLAY}/etc/skel/.config/kitty"
        cp -a "$DOTS_DIR/kitty"/. "${LIVE_OVERLAY}/etc/skel/.config/kitty"/
        info "  -> /etc/skel/.config/kitty"
    fi
fi

# Keep workspace tidy
rm -rf "$DOTS_DIR"

# ---------- Build ISO ----------
msg "Building ISO with buildiso -p ${PROFILE_NAME} -i ${INITSYS}"
mkdir -p "$OUT_DIR"

# Run buildiso from the workspace root so it finds iso-profiles/
pushd "$WORKSPACE_DIR" >/dev/null
if ! buildiso -p "$PROFILE_NAME" -i "$INITSYS"; then
    popd >/dev/null || true
    die "buildiso failed."
fi
popd >/dev/null || true

# Copy resulting ISO(s) to OUT_DIR
ISO_POOL="${WORKSPACE_DIR}/iso"
if [[ -d $ISO_POOL ]]; then
    shopt -s nullglob
    isos=("$ISO_POOL"/*.iso)
    shopt -u nullglob
    if (( ${#isos[@]} )); then
        cp -f "${isos[@]}" "$OUT_DIR"/
        msg "ISO built"
        ls -lh "$OUT_DIR"/*.iso
    else
        warn "No .iso found in ${ISO_POOL}"
    fi
else
    warn "ISO pool not found at ${ISO_POOL}"
fi

# ---------- Cleanup ----------
if (( KEEP_WORK )); then
    info "Workspace kept at ${WORKSPACE_DIR}"
else
    info "Cleaning workspace ${WORKSPACE_DIR}"
    rm -rf "${WORKSPACE_DIR:?}"
fi

msg "Done."
