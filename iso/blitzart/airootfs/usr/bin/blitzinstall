#!/usr/bin/env bash
# blitzinstall - BlitzArt Linux installer
# Inspired by archinstall | Artix + dinit + btrfs + snapper + grub-btrfs
#
# Usage: blitzinstall [--autopart] [-y]
# Booted into BlitzArt live ISO (tty)

set -uo pipefail

readonly VERSION="1.0.0"
readonly DISTRO_NAME="BlitzArt Linux"
readonly DISTRO_ID="blitzart"
readonly OS_RELEASE_PRETTY="BlitzArt Linux"
readonly OS_RELEASE_NAME="BlitzArt"
readonly OS_RELEASE_ID="artix"
readonly OS_RELEASE_ID_LIKE="arch"
readonly DOTS_REPO="https://github.com/nazwasadfh/dots.git"
readonly DOTS_DIR="/tmp/blitzart-dots"

# Colours
if [[ -t 1 ]]; then
    B=$'\e[1m'; R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; C=$'\e[36m'; N=$'\e[0m'
else
    B="" R="" G="" Y="" C="" N=""
fi

msg()  { printf '%s==>%s %s\n' "$G" "$N" "$*"; }
info() { printf '%s  ->%s %s\n' "$C" "$N" "$*"; }
warn() { printf '%s==> WARNING:%s %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%s==> ERROR:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

ask()     { local a; read -r -p "$1 [y/N] " a </dev/tty || return 1; [[ $a =~ ^[Yy]([Ee][Ss])?$ ]]; }
confirm() { (( ASSUME_YES )) && return 0; ask "$1"; }

# ---------- Global state ----------
ASSUME_YES=0
TARGET_DISK=""
TARGET_PART_EFI=""
TARGET_PART_ROOT=""
ROOT_SUBVOL="@"
HOME_SUBVOL="@home"
SNAPSHOT_SUBVOL="@snapshots"
MOUNTPOINT="/mnt"
USERNAME=""
USER_PASSWORD=""
ROOT_PASSWORD=""
KERNEL="linux"
LOCALE="en_US.UTF-8"
KEYMAP="us"
TIMEZONE="UTC"
HOSTNAME="blitzart"
AUTOPART=0
WITH_HOME_SUBVOL=0
REPO_ARTIX=1 REPO_ARCH=1 REPO_BLACKARCH=1 REPO_CHAOTIC_AUR=1

init_dev_setup() { :; }

# ---------- TUI helpers ----------
menu() {
    local title=$1 prompt=$2; shift 2
    local opts=("$@") chosen idx=1
    clear
    echo
    echo "  $B$title$N"
    echo "  ----------------------------------------"
    echo "  $prompt"
    echo
    for o in "${opts[@]}"; do
        printf '   %d) %s\n' "$idx" "$o"
        idx=$((idx+1))
    done
    echo
    read -r -p "  Select [1-${#opts[@]}]: " chosen </dev/tty || return 1
    [[ $chosen =~ ^[0-9]+$ ]] || { warn "Invalid choice."; return 1; }
    (( chosen >= 1 && chosen <= ${#opts[@]} )) || { warn "Out of range."; return 1; }
    MENU_SELECTION="${opts[$((chosen-1))]}"
    return 0
}

header() {
    clear
    echo
    echo "  $B$DISTRO_NAME Installer v$VERSION$N"
    echo "  Artix-based | dinit | btrfs + grub-btrfs"
    echo "  ----------------------------------------"
    echo
}

# ---------- Pre-flight ----------
require_root() {
    [[ $EUID -eq 0 ]] || die "Run as root."
}

require_tty() {
    [[ -t 0 ]] || die "blitzinstall must run interactively on a TTY."
}

check_network() {
    msg "Checking network connectivity (required)"
    if ! ping -c1 -W3 archlinux.org >/dev/null 2>&1 && ! ping -c1 -W3 1.1.1.1 >/dev/null 2>&1; then
        die "No internet connection. BlitzArt installation requires network."
    fi
    info "Network OK"
}

list_disks() {
    DISKS=()
    while IFS= read -r line; do
        DISKS+=("$line")
    done < <(lsblk -dno NAME,SIZE,TYPE,MODEL | awk '$3=="disk"{printf "%s | %s | %s\n", $1, $2, $4}')
}

# ---------- Steps ----------
step_welcome() {
    header
    echo "  Welcome to the BlitzArt Linux installer."
    echo "  This will install $DISTRO_NAME onto your disk."
    echo
    echo "  Features:"
    echo "    • Artix Linux base (dinit init)"
    echo "    • Btrfs root with full snapshots (snapper + grub-btrfs)"
    echo "    • Repos: artix, arch, blackarch, chaotic-aur"
    echo "    • blitz system toolbox"
    echo "    • Boot to TTY (no GUI by default)"
    echo
    if ! confirm "Continue with installation?"; then
        die "Aborted by user."
    fi
}

step_network() {
    check_network
}

step_disks() {
    header
    msg "Select target disk"
    list_disks
    if (( ${#DISKS[@]} == 0 )); then
        die "No disks found."
    fi
    for d in "${DISKS[@]}"; do echo "   $d"; done
    echo
    read -r -p "   Disk device (e.g. /dev/nvme0n1): " TARGET_DISK </dev/tty || return 1
    [[ -b $TARGET_DISK ]] || die "Not a block device: $TARGET_DISK"
    info "Target disk: $TARGET_DISK"
}

step_autopart() {
    header
    msg "Partitioning"
    if menu "Partitioning mode" "Choose partitioning mode:" \
        "Auto (one disk, GPT, EFI+root, btrfs)" \
        "Manual (advanced - not yet supported)"; then
        :
    fi
    AUTOPART=1

    # Optional @home subvolume for snapshots of /home
    header
    msg "Btrfs subvolumes"
    if ask "Create @home subvolume (snapshots of /home)?"; then
        WITH_HOME_SUBVOL=1
        info "@home subvolume enabled"
    else
        WITH_HOME_SUBVOL=0
        info "@home subvolume disabled"
    fi

    info "Autopartitioning selected (blkdiscard will wipe the disk)"
}

step_user() {
    header
    msg "User account"
    read -r -p "   Username: " USERNAME </dev/tty || return 1
    [[ -n $USERNAME ]] || die "Username required."
    read -r -s -p "   Password: " USER_PASSWORD </dev/tty; echo
    [[ -n $USER_PASSWORD ]] || die "Password required."
    read -r -s -p "   Root password: " ROOT_PASSWORD </dev/tty; echo
    [[ -n $ROOT_PASSWORD ]] || die "Root password required."
    info "User: $USERNAME (shell: zsh)"
}

step_keyboard() {
    header
    msg "Select keyboard layout"
    menu "Keyboard layout" "Choose your keyboard layout:" \
        "us" "gb" "de" "fr" "pl" "es" "it" "pt" "ru" "nl" \
        "cz" "sk" "hu" "ro" "se" "no" "dk" "fi" "tr" "br" "ca" "ch" "be"
    KEYMAP="$MENU_SELECTION"
    info "Keyboard layout: $KEYMAP"
}

step_kernel() {
    header
    msg "Select kernel"
    menu "Kernel" "Which kernel to install?" \
        "linux (stable)" \
        "linux-lts" \
        "linux-zen" \
        "linux-hardened"
    case $MENU_SELECTION in
        "linux (stable)") KERNEL="linux" ;;
        "linux-lts")      KERNEL="linux-lts" ;;
        "linux-zen")      KERNEL="linux-zen" ;;
        "linux-hardened") KERNEL="linux-hardened" ;;
    esac
    info "Kernel: $KERNEL"
}

step_repos() {
    header
    msg "Repositories"
    for r in arch blackarch chaotic-aur; do
        local var="REPO_$(echo $r | tr 'a-z-' 'A-Z_')"
        if ask "Enable $r repository?"; then
            eval "$var=1"
        else
            eval "$var=0"
        fi
    done
    info "Repositories configured."
}

step_snapshot() {
    header
    msg "Snapshots (snapper + grub-btrfs)"
    echo "  BlitzArt creates a btrfs snapshot after installation."
    echo "  You can later manage snapshots with: blitz snapshot <list|create|restore|prune>"
    echo
    if ask "Enable timeline snapshots (hourly/daily/weekly/monthly)?"; then
        ENABLE_TIMELINE=1
    else
        ENABLE_TIMELINE=0
    fi
    info "Timeline snapshots: $ENABLE_TIMELINE"
}

step_summary() {
    header
    msg "Installation summary"
    echo "   Disk:             $TARGET_DISK"
    echo "   Keyboard:         $KEYMAP"
    echo "   Kernel:           $KERNEL"
    echo "   User:             $USERNAME (shell: zsh)"
    echo "   @home subvolume:  $WITH_HOME_SUBVOL"
    echo "   Timeline snaps:   $ENABLE_TIMELINE"
    echo "   Repos:            arch=$REPO_ARCH blackarch=$REPO_BLACKARCH chaotic=$REPO_CHAOTIC_AUR"
    echo
    if ! confirm "Proceed with installation?"; then
        die "Aborted by user."
    fi
}

# ---------- Install ----------
do_partition() {
    msg "Wiping disk with blkdiscard -fv $TARGET_DISK"
    blkdiscard -fv "$TARGET_DISK"

    msg "Creating GPT partition table"
    parted -s "$TARGET_DISK" mklabel gpt

    msg "Creating EFI partition (512 MiB, fat32, boot, esp)"
    parted -s "$TARGET_DISK" mkpart ESP fat32 1MiB 513MiB
    parted -s "$TARGET_DISK" set 1 boot on
    parted -s "$TARGET_DISK" set 1 esp on

    msg "Creating root partition (rest of disk, btrfs)"
    parted -s "$TARGET_DISK" mkpart root btrfs 513MiB 100%

    # Wait for kernel to pick up partitions
    partprobe "$TARGET_DISK" || true
    sleep 2

    # Determine partition names
    if [[ $TARGET_DISK =~ nvme|mmcblk ]]; then
        TARGET_PART_EFI="${TARGET_DISK}p1"
        TARGET_PART_ROOT="${TARGET_DISK}p2"
    else
        TARGET_PART_EFI="${TARGET_DISK}1"
        TARGET_PART_ROOT="${TARGET_DISK}2"
    fi

    info "EFI: $TARGET_PART_EFI"
    info "Root: $TARGET_PART_ROOT"
}

do_format() {
    msg "Formatting EFI as FAT32"
    mkfs.fat -F32 -n EFI "$TARGET_PART_EFI"

    msg "Formatting root as Btrfs"
    mkfs.btrfs -f -L BLITZART_ROOT "$TARGET_PART_ROOT"

    msg "Creating btrfs subvolumes"
    mount -o noatime,compress=zstd "$TARGET_PART_ROOT" /mnt
    btrfs subvolume create /mnt/@
    if (( WITH_HOME_SUBVOL )); then
        btrfs subvolume create /mnt/@home
        info "Created @home subvolume"
    fi
    btrfs subvolume create /mnt/@snapshots
    umount /mnt
}

do_mount() {
    msg "Mounting subvolumes"
    mount -o noatime,compress=zstd,subvol=@ "$TARGET_PART_ROOT" "$MOUNTPOINT"
    mkdir -p "$MOUNTPOINT/.snapshots" "$MOUNTPOINT/boot/efi"
    mount -o noatime,compress=zstd,subvol=@snapshots "$TARGET_PART_ROOT" "$MOUNTPOINT/.snapshots"
    if (( WITH_HOME_SUBVOL )); then
        mkdir -p "$MOUNTPOINT/home"
        mount -o noatime,compress=zstd,subvol=@home "$TARGET_PART_ROOT" "$MOUNTPOINT/home"
    fi
    mount "$TARGET_PART_EFI" "$MOUNTPOINT/boot/efi"
}

do_pacstrap() {
    msg "Running pacstrap (installing base system)"

    local pkgs=(
        base base-devel dinit dinit-geninitrd dinit-openrc
        "$KERNEL" "$KERNEL-headers" linux-firmware
        intel-ucode amd-ucode
        grub grub-btrfs efibootmgr dosfstools btrfs-progs snapper
        snapper-tmpfiles networkmanager dinit-network
        zsh zsh-syntax-highlighting zsh-autosuggestions zsh-history-substring-search
        oh-my-zsh mcfly zoxide fzf bat eza ugrep tree fastfetch git starship
        nano vim curl wget pacman-contrib
    )

    # Note: keyrings and repositories are set up later in do_repos (after pacstrap).

    pacstrap -K "$MOUNTPOINT" "${pkgs[@]}"

    # Copy blitz tool
    install -D -m755 /usr/bin/blitz "$MOUNTPOINT/usr/bin/blitz" 2>/dev/null || {
        info "blitz not found on live system; will be installed post-pacstrap."
    }
}

do_configure_chroot() {
    msg "Configuring the new system (chroot)"

    arch-chroot "$MOUNTPOINT" /bin/bash <<EOF
set -e

# Locale
echo "$LOCALE UTF-8" > /etc/locale.gen
locale-gen
echo "LANG=$LOCALE" > /etc/locale.conf
export LANG=$LOCALE

# Timezone
ln -sf /usr/share/zoneinfo/$TIMEZONE /etc/localtime
hwclock --systohc

# Hostname
echo "$HOSTNAME" > /etc/hostname
cat > /etc/hosts <<HOSTS
127.0.0.1   localhost
::1         localhost
127.0.1.1   $HOSTNAME.localdomain $HOSTNAME
HOSTS

# Root password
echo "root:$ROOT_PASSWORD" | chpasswd

# User account (zsh shell, wheel for sudo)
useradd -m -G wheel -s /bin/zsh "$USERNAME"
echo "$USERNAME:$USER_PASSWORD" | chpasswd

# Enable wheel sudo
if ! grep -q '^%wheel' /etc/sudoers; then
    echo '%wheel ALL=(ALL:ALL) ALL' >> /etc/sudoers
fi

# Enable NetworkManager under dinit
ln -sf /etc/dinit.d/NetworkManager /etc/dinit.d/boot
ln -sf /etc/dinit.d/NetworkManager /etc/dinit.d/default

# Console keymap
echo "KEYMAP=$KEYMAP" > /etc/vconsole.conf

# mkinitcpio hooks for btrfs
sed -i 's/^HOOKS=.*/HOOKS=(base udev autodetect modconf kms keyboard keymap consolefont block filesystems fsck)/' /etc/mkinitcpio.conf
mkinitcpio -P

# GRUB install
grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=BlitzArt
EOF
    info "Base configuration complete."
}

do_repos() {
    msg "Setting up repositories"

    arch-chroot "$MOUNTPOINT" /bin/bash <<INSIDE
set -e

# --- Arch Linux repositories ---
if [[ ${REPO_ARCH} -eq 1 ]]; then
    echo "==> Installing artix-archlinux-support"
    pacman -S --noconfirm --needed artix-archlinux-support
    pacman-key --populate archlinux
    # Append arch repos at the END of pacman.conf
    cat >> /etc/pacman.conf <<'PACCONF'

# Arch
[extra]
Include = /etc/pacman.d/mirrorlist-arch

[multilib]
Include = /etc/pacman.d/mirrorlist-arch
PACCONF
fi

# --- BlackArch ---
if [[ ${REPO_BLACKARCH} -eq 1 ]]; then
    echo "==> Installing BlackArch (strap.sh)"
    curl -O https://blackarch.org/strap.sh
    chmod +x strap.sh
    ./strap.sh
    rm -f strap.sh
    pacman -Syu --noconfirm
fi

# --- Chaotic-AUR ---
if [[ ${REPO_CHAOTIC_AUR} -eq 1 ]]; then
    echo "==> Installing Chaotic-AUR"
    pacman-key --recv-key 3056513887B78AEB --keyserver keyserver.ubuntu.com
    pacman-key --lsign-key 3056513887B78AEB
    pacman -U --noconfirm 'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst'
    pacman -U --noconfirm 'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst'
    # Add chaotic-aur at the END of pacman.conf
    cat >> /etc/pacman.conf <<'PACCONF'

[chaotic-aur]
Include = /etc/pacman.d/chaotic-mirrorlist
PACCONF
fi
INSIDE

    info "Repositories configured."
}

do_os_release() {
    msg "Writing /etc/os-release and /etc/motd"

    cat > "$MOUNTPOINT/etc/os-release" <<EOF
NAME="$OS_RELEASE_NAME"
PRETTY_NAME="$OS_RELEASE_PRETTY"
ID="$OS_RELEASE_ID"
ID_LIKE="$OS_RELEASE_ID_LIKE"
VERSION="2026.11"
VERSION_ID="2026.11"
HOME_URL="https://blitzart.example.com/"
SUPPORT_URL="https://blitzart.example.com/"
BUG_REPORT_URL="https://blitzart.example.com/issues/"
LOGO=blitzart
EOF

    cat > "$MOUNTPOINT/etc/motd" <<EOF
____  ____  ____  ____  
 / ___/ ___/ / __ \/ __ \ 
/ /__/ /__  / /_/ / / / / 
\___/\___/  \____/_/ /_/  

Welcome to $DISTRO_NAME
Artix-based | dinit | btrfs + snapper + grub-btrfs
Run 'blitz help' for system management.
EOF

    info "os-release and motd written."
}

do_grub_customize() {
    msg "Customizing GRUB for BlitzArt branding"

    # Distributor override
    sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="BlitzArt"/' "$MOUNTPOINT/etc/default/grub" 2>/dev/null || true
    grep -q '^GRUB_DISTRIBUTOR=' "$MOUNTPOINT/etc/default/grub" 2>/dev/null || \
        echo 'GRUB_DISTRIBUTOR="BlitzArt"' >> "$MOUNTPOINT/etc/default/grub"

    arch-chroot "$MOUNTPOINT" grub-mkconfig -o /boot/grub/grub.cfg
    info "GRUB configured."
}

do_blitz_setup() {
    msg "Setting up blitz (snapper + grub-btrfs + snapshots)"

    arch-chroot "$MOUNTPOINT" /bin/bash <<EOF
set -e

# --- snapper config for root ---
snapper -c root create-config /

# Mount .snapshots subvolume at /.snapshots
mkdir -p /.snapshots
mount -o subvol=@snapshots /dev/$(basename ${TARGET_PART_ROOT}) /.snapshots 2>/dev/null || true

# Optional @home subvolume + snapper home config
if [[ ${WITH_HOME_SUBVOL} -eq 1 ]]; then
    mkdir -p /home
    mount -o subvol=@home /dev/$(basename ${TARGET_PART_ROOT}) /home 2>/dev/null || true
    snapper -c home create-config /home || true
fi

# Initial snapshot of root
snapper -c root create --description "Initial installation" --cleanup-algorithm number

# --- Timeline snapshots (hourly/daily/weekly/monthly) ---
if [[ ${ENABLE_TIMELINE} -eq 1 ]]; then
    # Enable timeline cleanup in snapper config
    sed -i 's/^TIMELINE_CREATE=.*/TIMELINE_CREATE="yes"/' /etc/snapper/configs/root 2>/dev/null || true
    sed -i 's/^TIMELINE_LIMIT_HOURLY=.*/TIMELINE_LIMIT_HOURLY="10"/' /etc/snapper/configs/root 2>/dev/null || true
    sed -i 's/^TIMELINE_LIMIT_DAILY=.*/TIMELINE_LIMIT_DAILY="10"/' /etc/snapper/configs/root 2>/dev/null || true
    sed -i 's/^TIMELINE_LIMIT_WEEKLY=.*/TIMELINE_LIMIT_WEEKLY="4"/' /etc/snapper/configs/root 2>/dev/null || true
    sed -i 's/^TIMELINE_LIMIT_MONTHLY=.*/TIMELINE_LIMIT_MONTHLY="2"/' /etc/snapper/configs/root 2>/dev/null || true
    if [[ ${WITH_HOME_SUBVOL} -eq 1 ]]; then
        sed -i 's/^TIMELINE_CREATE=.*/TIMELINE_CREATE="yes"/' /etc/snapper/configs/home 2>/dev/null || true
    fi
fi

# --- grub-btrfs: ensure snapshot entries appear in GRUB ---
if command -v grub-mkconfig >/dev/null 2>&1; then
    grub-mkconfig -o /boot/grub/grub.cfg
fi

# Create a systemd/dinit timer for timeline snapshots would go here
# (blitz snapshot prune handles cleanup)
EOF

    info "blitz setup complete."
}

do_copy_configs() {
    msg "Copying dotfiles from $DOTS_REPO"

    if [[ ! -d $DOTS_DIR/.git ]]; then
        info "Cloning $DOTS_REPO into $DOTS_DIR"
        git clone --depth 1 "$DOTS_REPO" "$DOTS_DIR"
    else
        git -C "$DOTS_DIR" pull --ff-only || warn "Could not update dots"
    fi

    local skel_target="$MOUNTPOINT/etc/skel"

    if [[ -d $DOTS_DIR/fastfetch ]]; then
        mkdir -p "$skel_target/.config/fastfetch"
        cp -a "$DOTS_DIR/fastfetch"/. "$skel_target/.config/fastfetch"/
        info "  -> /etc/skel/.config/fastfetch"
    fi

    if [[ -f $DOTS_DIR/.zshrc ]]; then
        cp -f "$DOTS_DIR/.zshrc" "$skel_target/.zshrc"
        info "  -> /etc/skel/.zshrc (from dots)"
    else
        warn ".zshrc not found in dots; writing a default zsh config"
        cat > "$skel_target/.zshrc" <<'ZSHRC'
# BlitzArt default zsh configuration
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git zsh-syntax-highlighting zsh-autosuggestions zsh-history-substring-search)
source $ZSH/oh-my-zsh.sh
eval "$(mcfly init zsh)"
eval "$(zoxide init zsh)"
eval "$(starship init zsh)"
ZSHRC
    fi

    if [[ -d $DOTS_DIR/kitty ]]; then
        mkdir -p "$skel_target/.config/kitty"
        cp -a "$DOTS_DIR/kitty"/. "$skel_target/.config/kitty"/
        info "  -> /etc/skel/.config/kitty"
    fi

    # New users get the zsh shell (set in do_configure_chroot)
    info "Configs copied to /etc/skel (will apply to new user on first login)."
}

do_finalize() {
    msg "Finalizing installation"

    # Unmount
    umount -R "$MOUNTPOINT" 2>/dev/null || umount -Rl "$MOUNTPOINT" 2>/dev/null || true

    info "Installation complete!"
    echo
    echo "  $B$DISTRO_NAME$N is installed."
    echo "  Reboot into your new system."
    echo
    echo "  Next steps:"
    echo "    • blitz snapshot create --description 'Post-install'"
    echo "    • blitz snapshot list"
    echo "    • blitz health"
    echo
}

# ---------- Main ----------
main() {
    while (( $# )); do
        case $1 in
            --autopart) AUTOPART=1; shift ;;
            --assume-yes|-y) ASSUME_YES=1; shift ;;
            -h|--help)
                echo "blitzinstall v$VERSION - BlitzArt Linux installer"
                echo "Usage: blitzinstall [--autopart] [-y]"
                exit 0 ;;
            *) die "Unknown option: $1" ;;
        esac
    done

    require_root
    require_tty

    step_welcome
    step_network
    step_disks
    step_autopart
    step_user
    step_keyboard
    step_kernel
    step_repos
    step_snapshot
    step_summary

    do_partition
    do_format
    do_mount
    do_pacstrap
    do_configure_chroot
    do_repos
    do_os_release
    do_grub_customize
    do_blitz_setup
    do_copy_configs
    do_finalize
}

main "$@"
