#!/usr/bin/env bash
# makeiso - Build BlitzArt Linux ISO (artools buildiso)
# Requires artools (provides buildiso)
#
# Thin wrapper around ./build-iso which stages the artools profile and runs
# buildiso -p blitzart -i dinit.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "${SCRIPT_DIR}/../../.." && pwd)"

exec "${PROJECT_DIR}/build-iso" "$@"