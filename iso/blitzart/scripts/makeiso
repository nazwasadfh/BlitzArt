#!/usr/bin/env bash
# makeiso - Copy new profile and build BlitzArt ISO (artools buildiso)
# Requires artools (provides buildiso)
#
# Thin wrapper around ./build-iso which creates the artools profile and runs
# buildiso -p blitzart -i dinit.

set -euo pipefail

VERSION="1.1.0"

msg() { printf '==> %s\n' "$*"; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

exec ./build-iso "$@"
